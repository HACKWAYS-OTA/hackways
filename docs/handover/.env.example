# HACKWAYS-OTA sanitized variable inventory, 20 October 2026.
# This is NOT a complete executable environment for every process at once.
# Credential fields are deliberately empty; obtain them through approved access.
# Do not replace a working ignored .env with this inventory.
# NEXT_PUBLIC_* values are public and usually embedded at frontend build time.

# ---- Backend process configuration: core and global, separately ----
APP_ENV=development
# Set 8081 for core; 8082 for global. The Go config's fallback is 8080.
PORT=
# Local loopback; production containers bind internally, never public ingress.
BIND_HOST=127.0.0.1
# Full PostgreSQL connection URI. Secret: includes credentials. No sample value.
DATABASE_URL=
# Core: 28/4; global production Compose: 22/3. Total DB cap: 60.
DB_MAX_CONNS=
DB_MIN_CONNS=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Required secure production config. Sessions use opaque tokens stored hashed in DB.
SESSION_SECRET=
# Core-only base64 32-byte Ed25519 seed; keep stable for signed tickets.
TICKET_SIGNING_SEED=
# Runtime limits: core 100MiB, global 90MiB; set per process.
GOMEMLIMIT=
GOGC=100

# ---- Local PostgreSQL Docker Compose inputs ----
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=5432

# ---- Production Compose database inputs (or supply DATABASE_URL above) ----
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
DB_SSLMODE=require
# Root template also lists these Azure names; Go engines do not read them directly.
AZURE_POSTGRES_HOST=
AZURE_POSTGRES_USER=
AZURE_POSTGRES_PASSWORD=
AZURE_POSTGRES_DB=

# ---- Azure Blob: global backend; uploads direct from browser ----
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_ACCOUNT_KEY=
# Optional public media base used by global code; current Compose must be reviewed
# to pass it through before assuming this variable changes the deployed service.
AZURE_CDN_DOMAIN=
# Container names media-uploads and backups are configured in code/scripts.

# ---- ACS email: global backend, PostgreSQL outbox ----
# All three explicit values required for sending. Keys remain blank here.
ACS_ENDPOINT=
ACS_ACCESS_KEY=
ACS_SENDER_ADDRESS=
# Supported legacy fallback. Explicit ACS_* values take precedence.
AZURE_ACS_CONNECTION_STRING=
AZURE_ACS_SENDER_ADDRESS=

# ---- Frontend browser/build values: examples below are local, nonsecret ----
# Production browser APIs use /api/v1 behind Nginx.
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1
NEXT_PUBLIC_GLOBAL_API_URL=http://localhost:8082/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_ORGANIZER_URL=http://localhost:3002
NEXT_PUBLIC_SUPPORT_EMAIL=SUPPORT@hackota.com
# Present in the root historical template; no current app consumer found.
NEXT_PUBLIC_SITE_NAME=Hackways
# Next.js server-only API origins. Never give these a NEXT_PUBLIC_ prefix.
CORE_API_URL=http://localhost:8081/api/v1
GLOBAL_API_URL=http://localhost:8082/api/v1
# NODE_ENV and NEXT_TELEMETRY_DISABLED are set by build/runtime configuration.
# Production per-app NODE_OPTIONS heap limits: public 100, core 190,
# organizer 180, admin 130 MB. Not a single shared value for all applications.
NODE_OPTIONS=

# ---- Production images and host deployer ----
# Change namespace only when destination packages and host pull access are verified.
DOCKER_REGISTRY=
# Full tested commit SHA, not a secret. Avoid mutable latest for releases.
IMAGE_TAG=
# Deployer passes the CI commit here; deploy.sh uses it to override IMAGE_TAG.
DEPLOY_IMAGE_TAG=
REPO_DIR=/opt/hackways
# Optional protected dotenv file for a separately staged checkout. The proposed
# script derives its project root from its location and never sources this file.
HACKWAYS_ENV_FILE=
# Production selection. The old live configuration is not changed by this template.
BRANCH=main
AUTO_DEPLOY_ENABLED=false
GITHUB_REPOSITORY=HACKWAYS-OTA/hackways
APPROVED_RELEASE_FILE=/etc/hackways/approved-release.json
DEPLOY_STATE_FILE=/var/lib/hackways-deployer/state.json
# HMAC webhook secret, held privately in the deployer environment.
WEBHOOK_SECRET=

# ---- Values NOT needed as manually created repository secrets ----
# GITHUB_TOKEN is issued automatically for each Actions job.
# Azure vault/resource/tenant IDs, registrar access and SSH/deploy credentials
# must be inventoried by the operator; no additional code-consumed variable names
# are invented in this file for integrations that are not configured in source.
