# Environment origins, included in the frontend at build time.
# Use the matching origins for each preview or deployment; no production fallback is applied.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_ORGANIZER_URL=http://localhost:3002

# Verified public support address; included in published contact and policy pages.
NEXT_PUBLIC_SUPPORT_EMAIL=SUPPORT@hackota.com
