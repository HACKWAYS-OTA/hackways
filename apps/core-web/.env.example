# Local attendee web (port 3001). Set these before building for other environments.
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1
NEXT_PUBLIC_GLOBAL_API_URL=http://localhost:8082/api/v1
# In production, use /api/v1 for both browser API URLs; Nginx routes to Go.
# Server-rendered private pages use the internal Go service addresses:
# CORE_API_URL=http://core-backend:8081/api/v1
# GLOBAL_API_URL=http://global-backend:8082/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_ORGANIZER_URL=http://localhost:3002
# Development-only Better Auth. Keep disabled until the session exchange is reviewed.
BETTER_AUTH_ENABLED=false
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_DATABASE_URL=postgres://hackways_user:hackways_password@localhost:5432/hackways_dev
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001
