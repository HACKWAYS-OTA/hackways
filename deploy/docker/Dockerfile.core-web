# syntax=docker/dockerfile:1
FROM node:22-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat

FROM base AS deps
WORKDIR /app
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/api-client/tsconfig.json ./packages/api-client/
COPY packages/api-client/src ./packages/api-client/src
RUN cd packages/api-client && npm install && npm run build

COPY apps/core-web/package.json ./apps/core-web/
COPY apps/core-web/package-lock.json* ./apps/core-web/
WORKDIR /app/apps/core-web
RUN npm install

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/packages/api-client ./packages/api-client
COPY --from=deps /app/apps/core-web/node_modules ./apps/core-web/node_modules
COPY apps/core-web ./apps/core-web

WORKDIR /app/apps/core-web
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3001
ENV HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/core-web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/core-web/.next/static ./apps/core-web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/core-web/.next/static ./.next/static

USER nextjs
EXPOSE 3001

CMD ["sh", "-c", "if [ -f apps/core-web/server.js ]; then node apps/core-web/server.js; else node server.js; fi"]
