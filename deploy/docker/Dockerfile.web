# syntax=docker/dockerfile:1
FROM node:22-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat

# 1. Install dependencies
FROM base AS deps
ARG APP_NAME
WORKDIR /app

# Setup shared api-client
COPY packages/api-client ./packages/api-client
RUN cd packages/api-client && npm install && npm run build

# Shared controls are compiled by each independent Next.js app
COPY packages/ui ./packages/ui

# Setup application package
COPY apps/${APP_NAME}/package.json ./apps/${APP_NAME}/
COPY apps/${APP_NAME}/package-lock.json* ./apps/${APP_NAME}/
WORKDIR /app/apps/${APP_NAME}
RUN npm install --install-links

# 2. Build the application
FROM base AS builder
ARG APP_NAME
WORKDIR /app

COPY --from=deps /app/packages/api-client ./packages/api-client
COPY --from=deps /app/packages/ui ./packages/ui
COPY --from=deps /app/apps/${APP_NAME}/node_modules ./apps/${APP_NAME}/node_modules
COPY apps/${APP_NAME} ./apps/${APP_NAME}

WORKDIR /app/apps/${APP_NAME}
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN npm run build

# 3. Production runner
FROM node:22-alpine AS runner
ARG APP_NAME
ARG PORT=3000
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=${PORT}
ENV HOSTNAME="0.0.0.0"
ENV APP_NAME=${APP_NAME}

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy standalone output and static assets
COPY --from=builder --chown=nextjs:nodejs /app/apps/${APP_NAME}/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/${APP_NAME}/.next/static ./apps/${APP_NAME}/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/${APP_NAME}/.next/static ./.next/static

USER nextjs
EXPOSE ${PORT}

CMD ["sh", "-c", "if [ -f apps/${APP_NAME}/server.js ]; then node apps/${APP_NAME}/server.js; else node server.js; fi"]
