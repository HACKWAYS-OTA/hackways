# syntax=docker/dockerfile:1
FROM node:22-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/admin-web/package.json ./apps/admin-web/
COPY apps/core-web/package.json ./apps/core-web/
COPY apps/organizer-web/package.json ./apps/organizer-web/
COPY apps/public-web/package.json ./apps/public-web/
COPY packages/api-client ./packages/api-client
COPY packages/ui ./packages/ui
RUN npm ci
RUN npm run build --workspace @hackways/api-client

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/packages/api-client ./packages/api-client
COPY --from=deps /app/packages/ui ./packages/ui
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY apps/organizer-web ./apps/organizer-web

WORKDIR /app/apps/organizer-web
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_GLOBAL_API_URL
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_ORGANIZER_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_GLOBAL_API_URL=$NEXT_PUBLIC_GLOBAL_API_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_ORGANIZER_URL=$NEXT_PUBLIC_ORGANIZER_URL
RUN npm run build

FROM node:22-alpine AS runner

ARG SOURCE_COMMIT=unreported
ENV SOURCE_COMMIT=$SOURCE_COMMIT
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3002
ENV HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/organizer-web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/organizer-web/.next/static ./apps/organizer-web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/organizer-web/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/organizer-web/public ./apps/organizer-web/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/organizer-web/public ./public

USER nextjs
EXPOSE 3002

CMD ["sh", "-c", "if [ -f apps/organizer-web/server.js ]; then node apps/organizer-web/server.js; else node server.js; fi"]
