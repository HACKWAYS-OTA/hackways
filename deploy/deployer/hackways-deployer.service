[Unit]
Description=Hackways CI Deployment Webhook
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=azureuser
Group=azureuser
WorkingDirectory=/opt/hackways
EnvironmentFile=/etc/hackways/deployer.env
Environment=REPO_DIR=/opt/hackways
Environment=BRANCH=main
Environment=AUTO_DEPLOY_ENABLED=false
Environment=GITHUB_REPOSITORY=HACKWAYS-OTA/hackways
StateDirectory=hackways-deployer
StateDirectoryMode=0700
ExecStart=/usr/local/bin/hackways-deployer
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
