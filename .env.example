# ==============================================================================
# Hackways — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets, tokens, or production credentials to source control.
# All values below are safe local development defaults.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server Configuration
# ------------------------------------------------------------------------------
APP_ENV=development             # development | test | staging | production
DOCKER_REGISTRY=ghcr.io/varshith-dev # CI-built images; set IMAGE_TAG to a published commit for production
IMAGE_TAG=latest
PORT=8080                       # Go backend HTTP port

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://hackways_user:hackways_password@localhost:5432/hackways_dev?sslmode=disable
DB_MAX_CONNS=28
DB_MIN_CONNS=4

# ------------------------------------------------------------------------------
# Authentication & Sessions
# ------------------------------------------------------------------------------
# 32-byte or longer random secret for cookie signing (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-secure-random-32-byte-hex-string-for-local-dev

# Google OAuth (optional until Google Cloud OAuth is configured). Never commit the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8082/api/v1/auth/google/callback
GOOGLE_ALLOWED_RETURN_ORIGINS=http://localhost:3001,http://localhost:3002

# ------------------------------------------------------------------------------
# CORS & Allowed Origins
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local Go processes bind to loopback by default. Containers use APP_ENV=production.
# BIND_HOST=127.0.0.1
# Core-only private Ed25519 seed: base64 of 32 cryptographically random bytes.
# Keep stable across restarts; never expose through NEXT_PUBLIC_* variables.
TICKET_SIGNING_SEED=

# ------------------------------------------------------------------------------
# Azure Managed Cloud Services (Production)
# ------------------------------------------------------------------------------
# Azure Database for PostgreSQL Flexible Server:
# DATABASE_URL=postgres://hackways_admin:<password>@hackways-db.postgres.database.azure.com:5432/hackways_prod?sslmode=require
AZURE_POSTGRES_HOST=hackways-db.postgres.database.azure.com
AZURE_POSTGRES_USER=hackways_admin
AZURE_POSTGRES_PASSWORD=
AZURE_POSTGRES_DB=hackways_prod

# Azure Blob Storage (Zero-Disk Upload Architecture via SAS):
AZURE_STORAGE_ACCOUNT=hackwaysstorage
AZURE_STORAGE_ACCOUNT_KEY=
# Public read origin only. Activate after deploy/cloudflare/README.md checks pass.
AZURE_CDN_DOMAIN=https://cdn.hackways.in

# ACS configuration placeholders; sending is implemented but requires verified configuration.
AZURE_ACS_CONNECTION_STRING=endpoint=https://hackways-comm.communication.azure.com/;accesskey=
# Global engine REST configuration. All three values are required to enable delivery.
ACS_ENDPOINT=
ACS_ACCESS_KEY=
ACS_SENDER_ADDRESS=notify@mail.hackways.in
ACS_TRANSACTIONAL_SENDER_ADDRESS=noreply@mail.hackways.in
ACS_PROMOTIONAL_SENDER_ADDRESS=updates@mail.hackways.in

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Hackways"

# Exact Nginx peer IP/CIDR on the internal Docker network; empty rejects location headers.
# Cloudflare Add visitor location headers must be enabled for city/region.
AUTH_LOCATION_PROXY_CIDRS=
