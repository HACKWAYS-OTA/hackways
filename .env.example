# ==============================================================================
# Hackways — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets, tokens, or production credentials to source control.
# All values below are safe local development defaults.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Server Configuration
# ------------------------------------------------------------------------------
APP_ENV=development             # development | test | staging | production
PORT=8080                       # Go backend HTTP port
BASE_URL=http://localhost:8080  # Base URL for API server
LOG_LEVEL=debug                 # debug | info | warn | error

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://hackways_user:hackways_password@localhost:5432/hackways_dev?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=hackways_user
DB_PASSWORD=hackways_password
DB_NAME=hackways_dev
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=15m

# ------------------------------------------------------------------------------
# Authentication & Sessions
# ------------------------------------------------------------------------------
# 32-byte or longer random secret for cookie signing (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-secure-random-32-byte-hex-string-for-local-dev
SESSION_NAME=hackways_session
SESSION_MAX_AGE_DAYS=30
SESSION_COOKIE_SECURE=false     # true in production (requires HTTPS)
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax     # lax | strict | none

# ------------------------------------------------------------------------------
# CORS & Allowed Origins
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Asset & File Storage
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local           # local | s3
LOCAL_STORAGE_DIR=./uploads     # local filesystem storage path
MAX_UPLOAD_SIZE_BYTES=5242880   # 5 MB maximum banner upload size

# S3 Configuration (only used if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=placeholder-aws-access-key-id
AWS_SECRET_ACCESS_KEY=placeholder-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=hackways-assets-dev
AWS_S3_ENDPOINT=                # optional custom S3/MinIO endpoint

# ------------------------------------------------------------------------------
# Notifications & Email (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025                  # MailHog / Mailpit local dev port
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Hackways Events"
SMTP_FROM_EMAIL=notifications@hackways.local

# ------------------------------------------------------------------------------
# Azure Managed Cloud Services (Production)
# ------------------------------------------------------------------------------
# Azure Database for PostgreSQL Flexible Server:
# DATABASE_URL=postgres://hackways_admin:<password>@hackways-db.postgres.database.azure.com:5432/hackways_prod?sslmode=require
AZURE_POSTGRES_HOST=hackways-db.postgres.database.azure.com
AZURE_POSTGRES_USER=hackways_admin
AZURE_POSTGRES_PASSWORD=
AZURE_POSTGRES_DB=hackways_prod

# Azure Blob Storage (Zero-Disk Upload Architecture via SAS):
AZURE_STORAGE_ACCOUNT=hackwaysstorage
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=media-uploads
AZURE_CDN_DOMAIN=https://media.hackways.in

# Azure Communication Services (ACS) Email:
AZURE_ACS_CONNECTION_STRING=endpoint=https://hackways-comm.communication.azure.com/;accesskey=
AZURE_ACS_SENDER_ADDRESS=notifications@hackways.in

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Hackways"
